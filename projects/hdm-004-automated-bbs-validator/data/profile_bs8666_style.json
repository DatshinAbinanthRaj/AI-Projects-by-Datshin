  "shapes": {
    "00": {"description": "Straight bar", "dimensions": ["A"], "formula": "A", "end_legs": []},
    "11": {"description": "One 90 degree bend (L bar)", "dimensions": ["A", "B"], "formula": "A + B - 0.5*r - d", "end_legs": ["A", "B"]},
