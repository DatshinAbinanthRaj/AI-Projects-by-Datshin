    "21": {"description": "Two 90 degree bends (U bar)", "dimensions": ["A", "B", "C"], "formula": "A + B + C - r - 2*d", "end_legs": ["A", "C"]},
    "31": {"description": "Three 90 degree bends", "dimensions": ["A", "B", "C", "D"], "formula": "A + B + C + D - 1.5*r - 3*d", "end_legs": ["A", "D"]},
    "33": {"description": "Closed loop with semi-circular ends", "dimensions": ["A", "B", "C"], "formula": "2*A + 1.7*B + 2*C - 4*d", "end_legs": [], "constraints": ["B >= 2*(r + d)"]},
    "41": {"description": "Four 90 degree bends (top hat)", "dimensions": ["A", "B", "C", "D", "E"], "formula": "A + B + C + D + E - 2*r - 4*d", "end_legs": ["A", "E"]},
    "44": {"description": "Four 90 degree bends (alternative layout)", "dimensions": ["A", "B", "C", "D", "E"], "formula": "A + B + C + D + E - 2*r - 4*d", "end_legs": ["A", "E"]},
    "51": {"description": "Closed link (stirrup)", "dimensions": ["A", "B", "C"], "formula": "2*(A + B + C) - 2.5*r - 5*d", "end_legs": ["C"]},
    "63": {"description": "Link variant with three short sides", "dimensions": ["A", "B", "C"], "formula": "2*A + 3*B + 2*C - 3*r - 6*d", "end_legs": ["C"]}
  }
}
